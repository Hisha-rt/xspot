<%- include('templates/encabezado', { tituloPagina: 'Catálogo' }) %>

<main class="store-container contenedor-extra-ancho">
    <h1 class="titulo-centrado">Catálogo XSPOT</h1>

    <form action="/catalogo" method="GET" class="barra-filtros">
        <input type="text" name="grupo" placeholder="Buscar grupo o artista (Ej. Doyoung, Baekhyun...)" class="input-filtro">
        
        <select name="tipo" class="input-filtro">
            <option value="Todos">Todas las categorías</option>
            <option value="Álbum">Álbumes</option>
            <option value="Photocard">Photocards</option>
            <option value="Merch Oficial">Otros</option>
        </select>
        
        <button type="submit" class="btn-buscar">Filtrar</button>
    </form>

    <div class="grid-productos">
       <% if (productos.length === 0) { %>
            <div class="sin-resultados">
                <h3 class="titulo-rosado">No encontramos lo que buscabas :C</h3>
                <p>¿No encuentras a tu <em>bias</em>, ese álbum en específico o la POB que te falta? ¡No te preocupes!</p>
                <p>Mándanos un mensaje con los detalles y te hacemos una cotización para abrir un <strong>Pedido Personalizado</strong>.</p>
                
                <a href="https://wa.me/528128859299?text=¡Hola!%20No%20encontré%20un%20artículo%20en%20el%20catálogo%20y%20me%20gustaría%20cotizar%20un%20Pedido%20Personalizado.%0A%0A*Mis%20datos:*%0A-%20Nombre%20real:%20%0A-%20Usuario%20(FB/IG/TikTok):%20%0A%0A*Artículo%20que%20busco:*%0A-%20Grupo/Artista:%20%0A-%20Producto%20y%20versión:%20%0A-%20Detalles%20extra%20(Inclusiones,%20tienda,%20etc.):%20" 
                   target="_blank" 
                   class="btn-primario btn-whatsapp-grande" style="display: inline-block; margin-top: 20px;">
                    Cotizar por WhatsApp
                </a>
            </div>
        <% } else { %>
            <% productos.forEach(producto => { %>
                
                <% 
                    let estaAgotado = (producto.stock === 0 || producto.estado_go === 'Agotado');
                    let esPreventa = (producto.estado_go === 'Pre-venta');
                %>
                
                <div class="tarjeta-producto <%= estaAgotado ? 'tarjeta-agotada' : '' %>">
                    <div class="imagen-container" style="position: relative;">
                        
                        <% if (estaAgotado) { %>
                            <div class="etiqueta-agotado-catalogo">AGOTADO</div>
                        <% } else if (esPreventa) { %>
                            <div class="etiqueta-preventa-catalogo">PRE-VENTA</div>
                        <% } %>
                        
                        <img src="<%= producto.imagen_url || '/src/img/placeholder.png' %>" alt="<%= producto.nombre %>" class="<%= estaAgotado ? 'imagen-opaca' : '' %>">
                    </div>

                    <div class="info-tarjeta">
                        <div class="info-superior">
                            <span class="badge-tipo"><%= producto.tipo %></span>
                            <h3><%= producto.nombre %></h3>
                            <div class="artista_grupo">
                                <div class="artista"><%= producto.artista %></div>
                                <div class="grupo"><%= producto.grupo %></div>
                            </div>
                        </div>
        
                        <div class="info-inferior">
                            <div class="precio">$<%= producto.precio %> MXN</div>
                            <a href="/producto/<%= producto.id %>" class="btn-ver">
                                <%= estaAgotado ? 'Ver Escaparate' : (esPreventa ? 'Reservar' : 'Ver Detalles') %>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</main>

<%- include('templates/pieDePagina') %>